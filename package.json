{
  "name": "hustlehub-plus-api",
  "version": "1.0.0",
  "description": "Secure backend foundations for the HustleHub+ freelance marketplace",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "setup:cert": "node scripts/generate-cert.js",
    "test": "node --test",
    "check": "npm test",
    "db": "node scripts/local-db.js",
    "build": "esbuild src/server.js --bundle --platform=node --format=cjs --target=node24 --packages=external --outfile=dist/server.js",
    "start:build": "node dist/server.js",
    "lint:ci": "node frontend/node_modules/oxlint/bin/oxlint --threads=2 --format=json --react-plugin --deny-warnings -D no-eval -D no-implied-eval -D no-new-func -D react/no-danger src scripts test frontend/src frontend/vite.config.js frontend/vitest.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.5",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "mongodb-memory-server": "^10.4.3",
    "newman": "^6.2.3",
    "selfsigned": "^3.0.1",
    "supertest": "^7.1.4"
  },
  "private": true
}
