{
  "info": {
    "name": "HustleHub+ Part 2 - Essential Tests",
    "description": "A focused collection of 20 requests covering registration/login, duplicate users, incorrect credentials, JWT protection, gig CRUD, ownership, role checks, input validation, client booking, freelancer booking history, simulated transactions and income. Run the entire collection once in order after restarting the local backend to clear rate counters. No environment file or token copying is needed. The first registration generates fresh test emails and clears saved IDs/tokens. It creates three test accounts, one gig, one booking and one simulated transaction. The gig is soft-deleted at the end; accounts and financial history remain. Rate-limiter and additional edge-case evidence is covered by the backend tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "hhBaseUrl",
      "value": "https://localhost:3443/api",
      "type": "string"
    },
    {
      "key": "hhTestPassword",
      "value": "SecurePass123!",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "pm.test('Security headers are present', function () {",
          "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.equal('nosniff');",
          "  pm.expect(pm.response.headers.get('Content-Security-Policy')).to.be.a('string').and.not.empty;",
          "  pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string').and.not.empty;",
          "  pm.expect(pm.response.headers.get('Cache-Control')).to.equal('no-store');",
          "  pm.expect(pm.response.headers.has('X-Powered-By')).to.equal(false);",
          "});",
          "pm.test('Responses do not expose passwords or internal details', function () {",
          "  const text = pm.response.text();",
          "  pm.expect(text).not.to.include('passwordHash');",
          "  pm.expect(text).not.to.include(pm.collectionVariables.get('hhTestPassword'));",
          "  pm.expect(text).not.to.match(/node_modules|JWT_SECRET|\"stack\"\\s*:/);",
          "});",
          "if (pm.response.code >= 400) {",
          "  pm.test('Error uses the controlled error structure', function () {",
          "    const error = pm.response.json().error;",
          "    pm.expect(error).to.be.an('object');",
          "    pm.expect(error.code).to.be.a('string').and.not.empty;",
          "    pm.expect(error.message).to.be.a('string').and.not.empty;",
          "    pm.expect(error).not.to.have.property('stack');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Register and log in - run first",
      "item": [
        {
          "name": "Register Owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{hhBaseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "description": "Expected HTTP status: 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Owner\",\n  \"email\": \"{{hhOwnerEmail}}\",\n  \"password\": \"{{hhTestPassword}}\",\n  \"role\": \"freelancer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('hhRunId', runId);",
                  "for (const actor of ['Owner', 'OtherFreelancer', 'Client', 'OtherClient']) {",
                  "  pm.collectionVariables.set('hh' + actor + 'Email', actor.toLowerCase() + '.' + runId + '@example.com');",
                  "  pm.collectionVariables.unset('hh' + actor + 'Token');",
                  "  pm.collectionVariables.unset('hh' + actor + 'Id');",
                  "}",
                  "for (const key of ['hhGigId', 'hhBookingId', 'hhTransactionId', 'hhTamperedToken']) {",
                  "  pm.collectionVariables.unset(key);",
                  "}",
                  "pm.collectionVariables.set('hhBookingRequestId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 201', function () { pm.response.to.have.status(201); });",
                  "",
                  "const user = pm.response.json().user;",
                  "pm.test('Registration returns a safe user and the selected role', function () {",
                  "  pm.expect(user.id).to.match(/^[a-f0-9]{24}$/i);",
                  "  pm.expect(user.role).to.equal('freelancer');",
                  "  pm.expect(user).not.to.have.property('password');",
                  "  pm.expect(user).not.to.have.property('passwordHash');",
                  "});",
                  "if (pm.response.code === 201) pm.collectionVariables.set('hhOwnerId', user.id);"
                ]
              }
            }
          ]
        },
