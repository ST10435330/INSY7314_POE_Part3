    {
      "name": "02 - Gigs and access controls",
      "item": [
        {
          "name": "Freelancer creates a gig - save gig ID automatically",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{hhBaseUrl}}/gigs",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{hhOwnerToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Expected HTTP status: 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman logo design\",\n  \"description\": \"Create a simple business logo. <script>alert(1)</script>\",\n  \"price\": 250\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 201', function () { pm.response.to.have.status(201); });",
                  "",
                  "const gig = pm.response.json().gig;",
                  "pm.test('Gig uses the authenticated owner and sanitised text', function () {",
                  "  pm.expect(gig.freelancerId).to.equal(pm.collectionVariables.get('hhOwnerId'));",
                  "  pm.expect(gig.price).to.equal(250);",
                  "  pm.expect(gig.description).not.to.match(/<|>|alert\\(1\\)/);",
                  "});",
                  "if (pm.response.code === 201) pm.collectionVariables.set('hhGigId', gig.id);"
                ]
              }
            }
          ]
        },
