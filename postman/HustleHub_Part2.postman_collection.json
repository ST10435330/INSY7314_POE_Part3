        {
          "name": "Log in Owner - save token automatically",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{hhBaseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "description": "Expected HTTP status: 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{hhOwnerEmail}}\",\n  \"password\": \"{{hhTestPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "const result = pm.response.json();",
                  "pm.test('Login returns a token and the correct account', function () {",
                  "  pm.expect(result.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(result.user.id).to.equal(pm.collectionVariables.get('hhOwnerId'));",
                  "  pm.expect(result.user.role).to.equal('freelancer');",
                  "});",
                  "if (pm.response.code === 200 && result.accessToken) {",
                  "  pm.collectionVariables.set('hhOwnerToken', result.accessToken);",
                  "  pm.test('JWT contains user identity, role and expiry', function () {",
                  "    const parts = result.accessToken.split('.');",
                  "    pm.expect(parts.length).to.equal(3);",
                  "    const Buffer = require('buffer').Buffer;",
                  "    const claims = JSON.parse(Buffer.from(parts[1], 'base64').toString('utf8'));",
                  "    pm.expect(claims.sub).to.equal(pm.collectionVariables.get('hhOwnerId'));",
                  "    pm.expect(claims.role).to.equal('freelancer');",
                  "    pm.expect(claims.exp).to.be.above(claims.iat);",
                  "    pm.expect(claims.iss).to.be.a('string').and.not.empty;",
                  "    pm.expect(claims.aud).to.be.a('string').and.not.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
