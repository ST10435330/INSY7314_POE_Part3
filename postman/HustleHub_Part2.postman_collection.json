    {
      "name": "03 - Booking transactions and income",
      "item": [
        {
          "name": "Client books a gig - save booking and transaction IDs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{hhBaseUrl}}/bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{hhClientToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Expected HTTP status: 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gigId\": \"{{hhGigId}}\",\n  \"requestId\": \"{{hhBookingRequestId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 201', function () { pm.response.to.have.status(201); });",
                  "",
                  "const result = pm.response.json();",
                  "pm.test('Booking and transaction use the server price and correct participants', function () {",
                  "  pm.expect(result.booking.amount).to.equal(300.5);",
                  "  pm.expect(result.transaction.amount).to.equal(300.5);",
                  "  pm.expect(result.booking.status).to.equal('confirmed');",
                  "  pm.expect(result.transaction.status).to.equal('simulated');",
                  "  pm.expect(result.booking.clientId).to.equal(pm.collectionVariables.get('hhClientId'));",
                  "  pm.expect(result.booking.freelancerId).to.equal(pm.collectionVariables.get('hhOwnerId'));",
                  "  pm.expect(result.transaction.bookingId).to.equal(result.booking.id);",
                  "  pm.expect(result.replay).to.equal(false);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('hhBookingId', result.booking.id);",
                  "  pm.collectionVariables.set('hhTransactionId', result.transaction.id);",
                  "}"
                ]
              }
            }
          ]
        },
